{
  "expo": {
    "name": "Forrageia",
    "slug": "front-end",
    "version": "1.2.1",
    "orientation": "portrait",
    "owner": "prantas",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "softwareKeyboardLayoutMode": "resize",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B4A2F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.deivyson05.frontend"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "O app usa a câmera para fotografar as plantas nos formulários.",
          "photosPermission": "O app acessa suas fotos para anexar imagens das plantas aos formulários."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "O app salva na sua galeria as fotos que você tira das plantas.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["photo"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b4e1f5f4-ab15-4242-b9d6-281cfb2786f4"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b4e1f5f4-ab15-4242-b9d6-281cfb2786f4"
    }
  }
}
